{
  "redirects": [
    {
      "source": "/milicsi",
      "destination": "https://milicsi.sharafdin.com/",
      "permanent": true
    },
    {
      "source": "/milicsi/",
      "destination": "https://milicsi.sharafdin.com/",
      "permanent": true
    },
    {
      "source": "/milicsi/:path*",
      "destination": "https://milicsi.sharafdin.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(llms\\.txt|robots\\.txt|sitemap\\.xml|feed\\.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
